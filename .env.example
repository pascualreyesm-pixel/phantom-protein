# URL pública de producción. En Preview la integración usa VERCEL_URL automáticamente.
NEXT_PUBLIC_URL=https://www.phantomprotein.cl

# Mercado Pago Checkout Pro (Preferences API).
# Production: Access Token y secreto del webhook de modo productivo.
# Preview: Access Token APP_USR de pruebas y secreto del webhook de modo prueba.
MERCADOPAGO_ACCESS_TOKEN=PEGA_AQUI_TU_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=PEGA_AQUI_TU_WEBHOOK_SECRET

# Supabase: clave privada solo para funciones del servidor.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=PEGA_AQUI_TU_SECRET_KEY

# Resend: dominio phantomprotein.cl verificado.
RESEND_API_KEY=PEGA_AQUI_TU_RESEND_API_KEY
PEDIDO_EMAIL_DESTINO=phantomproteinchile@gmail.com
RESEND_FROM_EMAIL=Phantom Protein <pedidos@phantomprotein.cl>

# Token aleatorio para proteger /api/admin/test-email.
EMAIL_TEST_TOKEN=GENERA_UN_TOKEN_LARGO_ALEATORIO
